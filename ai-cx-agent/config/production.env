# Production Environment Configuration
ENVIRONMENT=production

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-production-key-here
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=500

# Logging
LOG_LEVEL=WARNING
ENABLE_JSON_LOGS=true

# Features
ENABLE_PROACTIVE_FEATURES=true
ENABLE_CONTEXT_RESOLUTION=true
ENABLE_QUALITY_MONITORING=true

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=300
MAX_CONVERSATIONS_PER_HOUR=2000

# Integrations
ENABLE_WHATSAPP=true
ENABLE_EMAIL=true
ENABLE_INSTAGRAM=true
ENABLE_SHOPIFY=true

# Database
DATABASE_URL=postgresql://user:pass@prod-db:5432/ai_agent

# Monitoring
ENABLE_METRICS=true
ENABLE_ANALYTICS=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/production
POSTHOG_API_KEY=phc_production_key

# Security
ENABLE_SIGNATURE_VERIFICATION=true
WHATSAPP_VERIFY_TOKEN=your_secure_token
WHATSAPP_APP_SECRET=your_app_secret

# Brand Settings
DEFAULT_BRAND_ID=fashionhub

# Performance
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300
