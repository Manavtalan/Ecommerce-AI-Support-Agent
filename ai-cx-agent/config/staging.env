# Staging Environment Configuration
ENVIRONMENT=staging

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-staging-key-here
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=500

# Logging
LOG_LEVEL=INFO
ENABLE_JSON_LOGS=true

# Features
ENABLE_PROACTIVE_FEATURES=true
ENABLE_CONTEXT_RESOLUTION=true
ENABLE_QUALITY_MONITORING=true

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=120
MAX_CONVERSATIONS_PER_HOUR=500

# Integrations
ENABLE_WHATSAPP=true
ENABLE_EMAIL=true
ENABLE_INSTAGRAM=true
ENABLE_SHOPIFY=true

# Database
DATABASE_URL=postgresql://user:pass@staging-db:5432/ai_agent

# Monitoring
ENABLE_METRICS=true
ENABLE_ANALYTICS=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/staging
POSTHOG_API_KEY=phc_staging_key

# Brand Settings
DEFAULT_BRAND_ID=fashionhub
